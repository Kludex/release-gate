{
  "name": "release-gate",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "pnpm build:fonts && pnpm build:css && pnpm build:js",
    "build:fonts": "mkdir -p public/fonts && cp node_modules/@fontsource-variable/jost/files/jost-latin-wght-normal.woff2 public/fonts/jost.woff2 && cp node_modules/@fontsource/titan-one/files/titan-one-latin-400-normal.woff2 public/fonts/titan-one.woff2 && cp node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2 public/fonts/jetbrains-mono.woff2",
    "build:css": "tailwindcss -i src/styles.css -o public/app.css --minify",
    "build:js": "esbuild src/client/webauthn.ts --bundle --minify --format=esm --target=es2022 --outfile=public/app.js",
    "dev": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "check": "biome ci . && tsc --noEmit && vitest run --coverage",
    "test": "vitest run"
  },
  "dependencies": {
    "@octokit/webhooks-methods": "6.0.0",
    "@simplewebauthn/server": "14.0.3",
    "hono": "4.13.13",
    "universal-github-app-jwt": "2.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource/titan-one": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tailwindcss/cli": "4.3.3",
    "@vitest/coverage-istanbul": "4.1.12",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  }
}
